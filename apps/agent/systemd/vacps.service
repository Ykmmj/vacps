[Unit]
Description=VACPS Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/opt/vacps
EnvironmentFile=/etc/vacps/vacps.env
ExecStart=/usr/bin/node /opt/vacps/apps/agent/dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/vacps

[Install]
WantedBy=multi-user.target
