BACKEND_ID=vps-la-01
BACKEND_SHARED_TOKEN=replace-with-a-long-random-token
LISTEN_HOST=127.0.0.1
LISTEN_PORT=3100
REDIS_URL=rediss://default:password@host:port
DATABASE_PATH=/var/lib/vps-agent/agent.db
LOG_DIR=/var/lib/vps-agent/logs
WORKER_CONCURRENCY=1
RUN_MODE=all
PI_COMMAND=pi
# The adapter is line-delimited JSON. See docs/pi-adapter-protocol.md.
PI_COMMAND_ARGS_JSON=[]
DEFAULT_PROFILE=full
