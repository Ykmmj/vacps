{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-x86_64-musl-release",
      "displayName": "Linux x86_64 musl static Release (Alpine/Clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VACPS_STATIC": "ON",
        "VACPS_USE_SYSTEM_BOOST": "OFF",
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=lld"
      }
    },
    {
      "name": "linux-x86_64-musl-debug",
      "displayName": "Linux x86_64 musl Debug (dynamic OK)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VACPS_STATIC": "OFF",
        "VACPS_USE_SYSTEM_BOOST": "OFF",
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=lld"
      }
    },
    {
      "name": "linux-x86_64-musl-asan-ubsan",
      "displayName": "Linux x86_64 musl ASan+UBSan Debug (dynamic)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VACPS_STATIC": "OFF",
        "VACPS_USE_SYSTEM_BOOST": "OFF",
        "VACPS_ENABLE_ASAN": "ON",
        "VACPS_ENABLE_UBSAN": "ON",
        "VACPS_ENABLE_TSAN": "OFF",
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=lld"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "linux-x86_64-musl-tsan",
      "displayName": "Linux x86_64 musl TSan Debug (dynamic)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VACPS_STATIC": "OFF",
        "VACPS_USE_SYSTEM_BOOST": "OFF",
        "VACPS_ENABLE_ASAN": "OFF",
        "VACPS_ENABLE_UBSAN": "OFF",
        "VACPS_ENABLE_TSAN": "ON",
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=lld"
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "linux-x86_64-musl-release"
    },
    {
      "name": "debug",
      "configurePreset": "linux-x86_64-musl-debug"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "linux-x86_64-musl-asan-ubsan"
    },
    {
      "name": "tsan",
      "configurePreset": "linux-x86_64-musl-tsan"
    }
  ]
}
