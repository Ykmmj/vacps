BACKEND_ID=vps-la-01
BACKEND_NAME=Los Angeles VPS
BACKEND_TAGS=production,full
AGENT_PRIVATE_KEY=base64url-pkcs8-ed25519-private-key-generated-on-this-vps
AGENT_PUBLIC_KEY=base64url-raw-ed25519-public-key-paired-with-private-key
CONTROL_PLANE_PUBLIC_KEY=base64url-raw-ed25519-public-key-from-control-plane
REGISTRATION_TOKEN=one-time-token-from-control-panel-valid-for-ten-minutes
CONTROL_PLANE_URL=https://vacps-control.example.workers.dev
# Leave empty only when using --quick-tunnel; the helper writes its temporary URL here.
PUBLIC_BASE_URL=https://agent.example.com
REGISTRATION_INTERVAL_SECONDS=300
# Fallback only when the control plane is temporarily unreachable. The Web UI
# centrally controls the normal reporting interval (15–3600 seconds).
TELEMETRY_FALLBACK_INTERVAL_SECONDS=120
LISTEN_HOST=127.0.0.1
LISTEN_PORT=3100
REDIS_URL=rediss://default:password@host:port
DATABASE_PATH=/var/lib/vacps/agent.db
LOG_DIR=/var/lib/vacps/logs
WORKER_CONCURRENCY=1
RUN_MODE=all
PI_COMMAND=pi
# The adapter is line-delimited JSON. See docs/pi-adapter-protocol.md.
PI_COMMAND_ARGS_JSON=[]
DEFAULT_PROFILE=full
