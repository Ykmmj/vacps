[Unit]
Description=VACPS Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/opt/vacps
# Full agent identity for shell.exec (login env + ~/.bashrc).
Environment=HOME=/home/agent
Environment=USER=agent
Environment=LOGNAME=agent
Environment=SHELL=/bin/bash
EnvironmentFile=/etc/vacps/vacps.env
ExecStart=/usr/bin/node /opt/vacps/apps/vacps/dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
# ProtectHome=true replaces /home with an inaccessible mount (mode 000). Path walking
# still needs +x on /home to reach /home/agent, so BindPaths alone cannot fix shell
# login env. Agent runs untrusted commands already — allow real home.
ProtectHome=false
ReadWritePaths=/var/lib/vacps /home/agent /opt/vacps

[Install]
WantedBy=multi-user.target
