{
  "name": "@vps-agent/control-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:ui && pnpm run copy:installer && wrangler deploy --dry-run",
    "build:ui": "vite build",
    "check:ui": "svelte-check --tsconfig tsconfig.ui.json",
    "copy:installer": "node scripts/copy-installer.mjs",
    "dev": "pnpm run build:ui && pnpm run copy:installer && wrangler dev",
    "deploy": "pnpm run migrate:remote && pnpm run build:ui && pnpm run copy:installer && wrangler deploy",
    "migrate:remote": "wrangler d1 migrations apply vps-agent-control --remote",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm run check:ui"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.1",
    "@vps-agent/contracts": "workspace:*",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.21.0"
  }
}
