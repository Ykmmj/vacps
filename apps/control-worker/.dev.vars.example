CONTROL_PLANE_SIGNING_PRIVATE_KEY=base64url-pkcs8-ed25519-private-key
CONTROL_PLANE_SIGNING_PUBLIC_KEY=base64url-raw-ed25519-public-key
# Required for the control-plane UI. Use at least 12 non-whitespace characters.
CONTROL_PANEL_PASSWORD=replace-with-a-strong-control-panel-password
# Generate a random value of at least 32 non-whitespace characters for each environment.
CONTROL_PANEL_SESSION_SECRET=replace-with-a-random-session-signing-secret
# Optional: enables Cloudflare OAuth for Managed Tunnels in local development.
# Create a private Cloudflare OAuth client with the local callback below.
# CLOUDFLARE_OAUTH_CLIENT_ID=replace-with-oauth-client-id
# CLOUDFLARE_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
# CLOUDFLARE_OAUTH_REDIRECT_URL=http://localhost:8787/api/cloudflare/oauth/callback
