BACKEND_SHARED_TOKEN=replace-with-the-same-token-used-by-each-vps-agent
# Optional: enables Cloudflare OAuth for Managed Tunnels in local development.
# Create a private Cloudflare OAuth client with the local callback below.
# CLOUDFLARE_OAUTH_CLIENT_ID=replace-with-oauth-client-id
# CLOUDFLARE_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
# CLOUDFLARE_OAUTH_REDIRECT_URL=http://localhost:8787/api/cloudflare/oauth/callback
