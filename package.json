{
  "name": "vacps",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare control plane and VACPS multi-host task agents.",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "bind:managed-tunnel-account": "bash scripts/bind-managed-tunnel-account.sh",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "configure:managed-tunnels": "bash scripts/configure-managed-tunnels.sh",
    "repair:managed-tunnel-account": "bash scripts/configure-managed-tunnel-account.sh",
    "dev:control": "pnpm --filter @vacps/control-worker dev",
    "dev:agent": "pnpm --filter @vacps/agent dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "setup:cloudflare": "node scripts/run-cloudflare-setup.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @vacps/contracts build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.34.0"
  }
}
